\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Master performance and efficiency comparison on OMTG Bench ($N=320$).} All models operate zero-shot without fine-tuning. Frames denotes aggregate 8B ViT frames processed across all 320 query evaluations ($322.8\text  {f}$ avg for native). Best results are in \textbf  {bold}; second-best are \underline  {underlined}.}}{9}{}\protected@file@percent }
