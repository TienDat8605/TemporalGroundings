\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Original video duration vs. retained candidate corridor duration on OMTG Bench ($N=320$).} The diagonal dashed line ($W_{\mathrm  {len}} = T$) denotes unpruned whole-video baseline. For short videos ($T \le 45\text  {s}$), Adaptive SGDE safely retains the full video span ($0\%$ pruned, red points). For longer videos ($T > 45\text  {s}$), candidate corridor extraction prunes an average of $58.1\%$ of irrelevant background dead-zones (green points, shaded area), keeping dense decoding tightly focused.}}{9}{}\protected@file@percent }
\newlabel{fig:video_length_pruning}{{3}{9}{}{figure.3}{}}
